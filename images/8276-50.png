<?xml version="1.0" standalone="no"?>
<!DOCTYPE svg PUBLIC "-//W3C//DTD SVG 1.1//EN" "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
<svg width="50" height="50" viewBox="0 0 50 50" version="1.1" xmlns="http://www.w3.org/2000/svg">
  <g>
    <defs>
      <linearGradient id="avatar" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="rgb(255, 234, 219)"/>
        <stop offset="100%" stop-color="rgb(255, 234, 219)"/>
      </linearGradient>
    </defs>
    <rect fill="url(#avatar)" x="0" y="0" width="50" height="50"/>
    <text x="50%" y="50%" alignment-baseline="central" dominant-baseline="middle" text-anchor="middle" fill="#692673" font-family="apple color emoji, sans-serif" font-size="25.0" font-weight="bold">LF</text>
  </g>
</svg>
